rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function staffFor(buildingId) {
      return signedIn()
        && profile().buildingId == buildingId
        && profile().role in ['manager', 'admin', 'technician'];
    }

    match /maintenance/{buildingId}/{residentId}/{fileName} {
      allow create: if signedIn()
        && request.auth.uid == residentId
        && profile().role == 'resident'
        && profile().membershipStatus == 'active'
        && profile().buildingId == buildingId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow read: if signedIn()
        && ((request.auth.uid == residentId && profile().buildingId == buildingId)
          || staffFor(buildingId));

      allow update, delete: if false;
    }
  }
}
